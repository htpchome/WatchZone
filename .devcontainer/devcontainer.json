{
  "name": "Combined Integration Development",
  "initializeCommand": "bash .devcontainer/stop-conflicting-devcontainers.sh",
  "shutdownAction": "stopCompose",
  "dockerComposeFile": "docker-compose.yml",
  "service": "devcontainer",
  "workspaceFolder": "/workspaces/${localWorkspaceFolderBasename}",
  "mounts": [
    "source=${localWorkspaceFolderBasename}-python-venv,target=${containerWorkspaceFolder}/.venv,type=volume",
    "source=${localWorkspaceFolderBasename}-frontend-node-modules,target=${containerWorkspaceFolder}/frontend/node_modules,type=volume"
  ],

  "features": {
    "ghcr.io/devcontainers/features/docker-outside-of-docker:1": {},
    "ghcr.io/devcontainers/features/node:2.1.0": {
      "version": "20"
    },
    "ghcr.io/devcontainers/features/python:1": {
      "version": "3.14",
      "installTools": true
    },
    "ghcr.io/devcontainers/features/git:1": {},
    "ghcr.io/devcontainers/features/github-cli:1": {}
  },

  "customizations": {
    "vscode": {
      "extensions": [
        "openai.chatgpt",
        "ms-python.python",
        "ms-python.vscode-pylance",
        "charliermarsh.ruff",
        "dbaeumer.vscode-eslint",
        "esbenp.prettier-vscode",
        "vitest.explorer",
        "ms-vscode.vscode-json",
        "redhat.vscode-yaml",
        "keesschollaart.vscode-home-assistant",
        "ms-azuretools.vscode-docker"
      ],
      "settings": {
        "chat.mcp.enabled": true,
        "editor.formatOnSave": true,
        "editor.defaultFormatter": "esbenp.prettier-vscode",
        "python.defaultInterpreterPath": "${workspaceFolder}/.venv/bin/python",
        "python.analysis.typeCheckingMode": "basic",
        "files.associations": {
          "*.yaml": "yaml"
        },
        "[python]": {
          "editor.defaultFormatter": "charliermarsh.ruff",
          "editor.formatOnSave": true
        },
        "[typescript]": {
          "editor.defaultFormatter": "esbenp.prettier-vscode"
        },
        "[typescriptreact]": {
          "editor.defaultFormatter": "esbenp.prettier-vscode"
        },
        "mcp.servers": {
          "sequential-thinking": {
            "command": "npx",
            "args": ["-y", "@modelcontextprotocol/server-sequential-thinking"]
          },
          "playwright": {
            "command": "npx",
            "args": [
              "-y",
              "@playwright/mcp@latest",
              "--headless",
              "--browser",
              "chromium"
            ]
          }
        }
      }
    }
  },

  "forwardPorts": [8123, 5000, 8554, 1984, 5173],
  "portsAttributes": {
    "8123": {
      "label": "Home Assistant",
      "onAutoForward": "notify"
    },
    "5000": {
      "label": "Frigate Web UI",
      "onAutoForward": "notify"
    },
    "8554": {
      "label": "Frigate go2rtc",
      "onAutoForward": "silent"
    },
    "1984": {
      "label": "go2rtc Web UI",
      "onAutoForward": "silent"
    },
    "5173": {
      "label": "TypeScript Dev Server",
      "onAutoForward": "notify"
    }
  },

  "postCreateCommand": "bash .devcontainer/post-create.sh",
  "postStartCommand": "bash .devcontainer/post-start.sh",
  "remoteUser": "node"
}
