{
  "name": "watchzone-frontend",
  "private": true,
  "version": "0.0.4-dev.98",
  "type": "module",
  "packageManager": "yarn@4.18.1",
  "engines": {
    "node": ">=20.19 <21"
  },
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "yarn check:architecture && yarn check:styles && yarn check:licenses && tsc --noEmit && vite build",
    "build:release": "yarn build && bash ../scripts/package-release.sh",
    "check:version": "node ../scripts/check-version.mjs",
    "check:licenses": "node ../scripts/validate-third-party-notices.mjs",
    "check:architecture": "node ../scripts/validate-architecture.mjs",
    "check:styles": "node ../scripts/validate-styles.mjs",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --check .",
    "test": "vitest run",
    "test:browser": "playwright test"
  },
  "dependencies": {
    "hls.js": "1.7.4",
    "lit": "^3.3.3",
    "swiper": "14.4.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "1.62.1",
    "@types/node": "^20.19.43",
    "@webcomponents/scoped-custom-element-registry": "0.0.10",
    "eslint": "^10.14.0",
    "eslint-plugin-lit": "^2.3.1",
    "eslint-plugin-wc": "^3.1.0",
    "globals": "^17.13.0",
    "jsdom": "^29.1.1",
    "prettier": "^3.9.10",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.1",
    "vite": "^8.3.5",
    "vitest": "^4.1.12"
  },
  "resolutions": {
    "minimatch": "^11.0.1"
  }
}
